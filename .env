EXPO_PUBLIC_BACKEND_API_URL=https://api.morapay.io

# Same Dynamic environment the real checkout app (frontend/apps/checkout)
# uses, so a wallet connected here shows up as the same Dynamic identity.
#
# Production (Vercel) uses apps/app's own real environment
# (d4013575-4328-47d6-8bef-2b85b9d38db0, from Infisical's /frontend/app
# path) — that one already allowlists app.morapay.io since apps/app itself
# runs there. Local dev keeps this different value below because that
# environment's Dynamic dashboard settings don't allowlist
# `http://localhost:8081` (confirmed live: `app.dynamicauth.com`'s SDK
# settings endpoint 403s on CORS preflight for it) — switching local dev to
# the real one too needs that origin added in Dynamic's dashboard first.
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=dc580136-2163-428f-9118-6e3efce9eff1

# Real values needed for the transaction tracker's real-time push (Tier 2) —
# see .env.example's own doc. Left blank: I don't have Core's actual
# PUSHER_KEY/PUSHER_CLUSTER (not in this repo, likely Infisical). Blank is
# safe — the realtime client no-ops without them and the tracker keeps
# working via its existing polling.
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=
