# Morapay backend (pure proxy, no auth required for /api/public, /api/squid,
# /api/balances) — local dev: http://localhost:4001, prod: https://api.morapay.io
EXPO_PUBLIC_BACKEND_API_URL=https://api.morapay.io

# Dynamic Labs wallet-connect environment id — same one frontend/apps/checkout
# uses (see its .env), so wallets connected here share the same identity.
#
# frontend/apps/app's own environment has more wallet connectors (Stellar,
# Bitcoin, Sui, Tron) but is NOT a drop-in swap: its Dynamic dashboard
# settings don't currently allowlist this app's origin/bundle id, and
# pointing here at it breaks Connect Wallet outright (CORS-blocked
# `/sdk/<id>/settings` call) until that's fixed on Dynamic's side first.
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Pusher's public key/cluster (never the secret — that stays server-side in
# Core's own env) — same app Core's PUSHER_KEY/PUSHER_CLUSTER point at, so a
# transaction's real-time status channel (private-ramp-<merchantReference>,
# see core/src/services/pusher.service.ts) actually resolves. Optional: the
# transaction tracker's own polling (TransactionStoreContext.tsx) works
# without these, just without the faster push path — see src/realtime's doc.
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=
